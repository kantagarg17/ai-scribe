# ---------------------------------------------------------------------------
# AI-Scribe backend configuration
#
# Copy to .env and edit. Everything AI-related is pluggable so the project
# stays open-source and vendor-neutral. Pick "local" to run entirely on your
# own machine, or "openai" to use any OpenAI-compatible endpoint.
# ---------------------------------------------------------------------------

# App
AISCRIBE_DATA_DIR=./data
AISCRIBE_CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# ZERO-SETUP DEMO MODE
# Set all three providers to "mock" to run AI-Scribe with no models, no
# network, and no API keys. Output is rule-based and clearly not a real model,
# but every screen works. Great for a first look and for tests.
#
#   AISCRIBE_LLM_PROVIDER=mock
#   AISCRIBE_TRANSCRIBE_PROVIDER=mock
#   AISCRIBE_EMBED_PROVIDER=mock
#
# For real output, use the local open-source or OpenAI-compatible settings
# below.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# FREE CLOUD MODE (Groq) - used by the hosted deployment (see render.yaml)
# Groq is an OpenAI-compatible API with a free tier that serves open Llama
# models AND Whisper transcription from one key + base URL. Embeddings run
# locally with the built-in lightweight provider (no key, fits small hosts).
#
#   AISCRIBE_LLM_PROVIDER=openai
#   AISCRIBE_TRANSCRIBE_PROVIDER=openai
#   AISCRIBE_EMBED_PROVIDER=mock
#   AISCRIBE_OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   AISCRIBE_OPENAI_API_KEY=gsk_...            # from https://console.groq.com/keys
#   AISCRIBE_LLM_MODEL=llama-3.3-70b-versatile
#   AISCRIBE_TRANSCRIBE_MODEL=whisper-large-v3
#   AISCRIBE_SEED_ON_START=1                   # seed demo patient on boot
#   AISCRIBE_CORS_ORIGINS=https://your-site.netlify.app
# ---------------------------------------------------------------------------

# --- LLM provider: "mock" | "ollama" | "openai" ---
AISCRIBE_LLM_PROVIDER=ollama
# For ollama (local, open-source): https://ollama.com
AISCRIBE_OLLAMA_BASE_URL=http://localhost:11434
AISCRIBE_LLM_MODEL=llama3.1
# For any OpenAI-compatible endpoint, set provider=openai and fill these:
AISCRIBE_OPENAI_BASE_URL=https://api.openai.com/v1
AISCRIBE_OPENAI_API_KEY=
# AISCRIBE_LLM_MODEL=gpt-4o-mini

# --- Transcription provider: "mock" | "faster_whisper" | "openai" ---
AISCRIBE_TRANSCRIBE_PROVIDER=faster_whisper
AISCRIBE_WHISPER_MODEL=base
# For openai transcription, reuses AISCRIBE_OPENAI_* above:
AISCRIBE_TRANSCRIBE_MODEL=whisper-1

# --- Embedding provider: "mock" | "sentence_transformers" | "openai" ---
# NOTE: if you change the embedding provider or model after adding documents,
# rebuild the stored vectors so retrieval stays consistent:
#   python -m app.reindex
AISCRIBE_EMBED_PROVIDER=sentence_transformers
AISCRIBE_EMBED_MODEL=all-MiniLM-L6-v2
# For openai embeddings, reuses AISCRIBE_OPENAI_* above:
# AISCRIBE_EMBED_MODEL=text-embedding-3-small
